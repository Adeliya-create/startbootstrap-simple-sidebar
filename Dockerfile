# Берём официальный образ Nginx.
# Alpine — это очень маленький Linux (~5MB).
# Нам не нужна полноценная ОС — только Nginx.
FROM nginx:alpine

# Удаляем стандартную страницу Nginx.
# По умолчанию Nginx показывает страницу "Welcome to nginx".
# Нам она не нужна — мы заменим её нашим сайтом.
RUN rm -rf /usr/share/nginx/html/*

# Копируем наш сайт внутрь контейнера.
# Всё что в папке dist/ — копируем в папку откуда Nginx раздаёт файлы.
COPY dist/ /usr/share/nginx/html/

# Документируем что контейнер слушает порт 80.
# Это просто пометка — порт откроется через docker-compose.
EXPOSE 80

# Запускаем Nginx в foreground режиме.
# "daemon off" означает — не уходи в фоновый режим.
# Если Nginx уйдёт в фон — Docker решит что процесс завершился
# и остановит контейнер. Поэтому держим его на переднем плане.
CMD ["nginx", "-g", "daemon off;"]